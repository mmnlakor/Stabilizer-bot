# ============================================================
# Stabilizer Finance LP Bot — Environment Configuration
# Sepolia Testnet
# ============================================================

# --- Wallet ---
PRIVATE_KEY=

# --- Network ---
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# --- Pool Contracts ---
TPOOL_ADDRESS=0x7C348b70F640B47b64ecDb154960D337ce7a98B4
CPOOL_ADDRESS=0x0578E5EA652C62DB20F4475F685A4b587314A30f
SPOOL_ADDRESS=0xC94fbB2C1DA52F8561A829a4838f117DD7316F54

# --- Underlying tokens for each pool ---
# Each deposit pulls equal value of the pool's paired token AND USDZ
TPOOL_TOKEN_ADDRESS=0xee0418Bd560613fbcF924C36235AB1ec301D4933
CPOOL_TOKEN_ADDRESS=0x77ef087024F87976aAdA0Aa7F73BB8EAe6E9dda1
SPOOL_TOKEN_ADDRESS=0xF85938e2Bfc178026f60c5Ea50cC347D42C73b3D
USDZ_ADDRESS=0x55Cc481D28Db3f1ffc9347745AA6fbB940505BdD

# --- Deposit Behavior ---
# Percentage of the pool's paired token balance to deposit each cycle
DEPOSIT_PERCENT=50

# How long to hold the LP position before withdrawing (minutes)
HOLD_MINUTES=120

# How long to wait after withdrawal before depositing into the next pool (minutes)
POST_WITHDRAW_WAIT_MINUTES=120

# How often the scheduler checks for due actions (seconds)
TICK_INTERVAL_SECONDS=30

# --- Retry / Resilience ---
MAX_RETRIES=3
RETRY_DELAY_SECONDS=15
GAS_LIMIT_MULTIPLIER=1.3

# --- State persistence ---
# Must point to a Railway Volume mount path to survive redeploys.
# e.g. STATE_FILE_PATH=/data/state.json
STATE_FILE_PATH=./state.json
